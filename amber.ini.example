# amber.ini — пример конфигурации Amber Commander
# Файл создаётся автоматически при первом запуске рядом с amber.exe.

[main]
; 0 = «Янтарь» (тёмная янтарная), 1 = тёмная «Кофе/Какао», 2 = «Холодная»,
; 3 = «Фосфор», 4 = «Сталь», 5 = «FAR», 6 = «Спектр», 7 = «Ночной циан»,
; 8 = «Уголь» (стиль OpenCode)
theme=0
; ширина панелей (Shift+←/→) не сохраняется — при запуске 50/50
; редактор для F4
editor=notepad.exe
; последние каталоги панелей (сохраняются при выходе)
leftDir=
rightDir=
; подтверждения
confirmDelete=1
confirmOverwrite=1
; показывать скрытые файлы
showHidden=1
; актуализировать глобальный индекс каталогов (folders.idx) при каждом запуске:
; 1 (по умолчанию) — фоновая пересборка по всем дискам при каждом открытии (поиск
;     работает сразу, во время пересборки в правом краю командной строки виден едва
;     заметный серый индикатор «индексация поиска…», после успешного завершения —
;     короткое подтверждение «индекс поиска обновлён»), 0 — пересборка только если
;     индекс старше недели
folderIndexRefresh=1
; окно: позиция и размер (сохраняются при выходе; без winRect — по центру)
winRect=200,150,900,700
winMax=0

; Где лежит этот файл: рядом с amber.exe. Если папка exe недоступна для
; записи (Program Files и т.п.) — используется %APPDATA%\Amber Commander\amber.ini

; Меню пользователя (F2): номер=Подпись|команда
; Команда "cd <каталог>" — переход панели, иначе запуск через cmd /C
[usermenu]
1=Документы|cd %USERPROFILE%\Documents
2=Загрузки|cd %USERPROFILE%\Downloads
3=Командная строка|cmd.exe
